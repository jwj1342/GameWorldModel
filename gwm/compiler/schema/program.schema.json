{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gameworldmodel/program.schema.json",
  "title": "4D Scene Program (minimal vocabulary)",
  "type": "object",
  "required": ["meta", "static", "objects"],
  "additionalProperties": false,
  "properties": {
    "meta": {"type": "object", "required": ["clip"], "additionalProperties": true,
      "properties": {"clip": {"type": "string"}, "fps": {"type": "number", "exclusiveMinimum": 0}, "duration": {"type": "number", "exclusiveMinimum": 0},
        "units": {"type": "string", "enum": ["m"]}, "up": {"type": "string", "enum": ["y"]}, "notes": {"type": "string"}}},
    "style": {"type": "object", "additionalProperties": true, "properties": {"background": {"type": "string"}}},
    "camera": {"type": "object", "additionalProperties": false,
      "properties": {
        "intrinsics": {"type": "object", "additionalProperties": true, "properties": {"fov_deg": {"type": "number", "exclusiveMinimum": 1, "exclusiveMaximum": 179}, "aspect": {"type": "number", "exclusiveMinimum": 0}, "far": {"type": "number", "exclusiveMinimum": 0}}},
        "keyframes": {"type": "array", "items": {"type": "object", "required": ["t", "pos"], "additionalProperties": false,
          "properties": {"t": {"type": "number", "minimum": 0}, "pos": {"$ref": "#/$defs/vec3"}, "quat": {"$ref": "#/$defs/quat"}, "look_at": {"$ref": "#/$defs/vec3"}}}},
        "interp": {"type": "string", "enum": ["linear", "catmull_rom"]}}},
    "static": {"type": "array", "items": {"$ref": "#/$defs/staticNode"}},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/objectNode"}},
    "binding": {"type": "object", "additionalProperties": false,
      "properties": {"template": {"type": "string", "enum": ["platformer_3p"]},
        "slots": {"type": "object", "additionalProperties": true,
          "properties": {"player_spawn": {"$ref": "#/$defs/vec3"},
            "goal_volume": {"type": "object", "required": ["pos"], "properties": {"pos": {"$ref": "#/$defs/vec3"}, "extent": {"$ref": "#/$defs/vec3"}}},
            "walkable": {}, "hazards": {"type": "array", "items": {"type": "string"}}, "collectibles": {"type": "array", "items": {"type": "string"}}}}}},
    "residual": {"type": ["object", "null"]}
  },
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "vec2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "quat": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "pose": {"type": "object", "required": ["pos"], "additionalProperties": false, "properties": {"pos": {"$ref": "#/$defs/vec3"}, "quat": {"$ref": "#/$defs/quat"}}},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 48},
    "material": {"type": "string", "maxLength": 32},
    "primitiveGeom": {"type": "object", "required": ["kind", "shape"], "additionalProperties": false,
      "properties": {"kind": {"const": "primitive"}, "shape": {"type": "string", "enum": ["box", "sphere", "cylinder", "cone", "plane"]},
        "extent": {"$ref": "#/$defs/vec3"}, "size": {"$ref": "#/$defs/vec2"}, "radius": {"type": "number", "exclusiveMinimum": 0},
        "radius_top": {"type": "number", "minimum": 0}, "radius_bottom": {"type": "number", "minimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0},
        "axis": {"type": "string", "enum": ["x", "y", "z"]}, "material": {"$ref": "#/$defs/material"}}},
    "heightfieldGeom": {"type": "object", "required": ["kind", "scale"], "additionalProperties": false,
      "properties": {"kind": {"const": "heightfield"}, "ref": {"type": "string"}, "scale": {"$ref": "#/$defs/vec3"}}},
    "assetGeom": {"type": "object", "required": ["kind", "query", "extent"], "additionalProperties": false,
      "properties": {"kind": {"const": "asset"}, "query": {"type": "string", "maxLength": 80}, "extent": {"$ref": "#/$defs/vec3"}}},
    "generatedGeom": {"type": "object", "required": ["kind", "ref", "extent"], "additionalProperties": false,
      "properties": {"kind": {"const": "generated"}, "ref": {"type": "string"}, "extent": {"$ref": "#/$defs/vec3"}}},
    "staticNode": {"type": "object", "required": ["id", "geom", "pose"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "class": {"type": "string", "maxLength": 40},
        "geom": {"anyOf": [{"$ref": "#/$defs/primitiveGeom"}, {"$ref": "#/$defs/heightfieldGeom"}]},
        "pose": {"$ref": "#/$defs/pose"}, "material": {"$ref": "#/$defs/material"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "notes": {"type": "string"}}},
    "schedule": {"type": "array", "items": {"type": "object", "required": ["t"], "additionalProperties": false,
      "properties": {"t": {"type": "number", "minimum": 0}, "to": {"type": "number"}, "to_deg": {"type": "number"}, "duration": {"type": "number", "exclusiveMinimum": 0}}}},
    "motion": {"type": "object", "required": ["type"], "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["static", "trajectory", "revolute", "prismatic", "periodic_translate", "periodic_rotate", "spin"]},
        "keyframes": {"type": "array", "items": {"type": "object", "required": ["t", "pos"], "additionalProperties": false, "properties": {"t": {"type": "number", "minimum": 0}, "pos": {"$ref": "#/$defs/vec3"}, "quat": {"$ref": "#/$defs/quat"}}}},
        "interp": {"type": "string", "enum": ["linear", "catmull_rom"]},
        "axis": {"$ref": "#/$defs/vec3"}, "pivot": {"$ref": "#/$defs/vec3"},
        "range_deg": {"$ref": "#/$defs/vec2"}, "from_deg": {"type": "number"}, "rate_dps": {"type": "number"},
        "range": {"$ref": "#/$defs/vec2"}, "from": {"type": "number"}, "rate": {"type": "number"},
        "schedule": {"$ref": "#/$defs/schedule"},
        "amp": {"type": "number", "minimum": 0}, "amp_deg": {"type": "number", "minimum": 0}, "period": {"type": "number", "exclusiveMinimum": 0}, "phase": {"type": "number"},
        "trigger": {"type": "boolean"}}},
    "event": {"type": "object", "required": ["type"], "additionalProperties": false,
      "properties": {"type": {"type": "string", "enum": ["despawn_on_contact", "trigger_on_enter"]}, "with": {"type": "string"},
        "volume": {"type": "object", "properties": {"pos": {"$ref": "#/$defs/vec3"}, "extent": {"$ref": "#/$defs/vec3"}}}, "target": {"type": "string"}, "action": {"type": "string", "enum": ["open", "start", "stop"]}}},
    "objectNode": {"type": "object", "required": ["id", "class", "geom"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "class": {"type": "string", "maxLength": 40}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "geom": {"anyOf": [{"$ref": "#/$defs/primitiveGeom"}, {"$ref": "#/$defs/assetGeom"}, {"$ref": "#/$defs/generatedGeom"}]},
        "pose": {"$ref": "#/$defs/pose"}, "instances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pose"}},
        "material": {"$ref": "#/$defs/material"}, "motion": {"$ref": "#/$defs/motion"}, "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "support": {"type": "string"}, "notes": {"type": "string"}}}
  }
}
